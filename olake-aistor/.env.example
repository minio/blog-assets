# Copy to .env and fill in. Docker Compose loads .env automatically.

# MinIO AIStor image (AIStor Tables needs RELEASE.2026-02-02 or later)
# Find releases at: https://quay.io/repository/minio/aistor/minio?tab=tags
MINIO_TEST_IMAGE=quay.io/minio/aistor/minio:RELEASE.2026-09-19T17-05-25Z.hotfix.175a5c7f2f85

# MinIO License. Get one from https://subnet.min.io
MINIO_LICENSE=

# OLake Postgres connector (includes the Iceberg Java writer)
# Find releases at: https://hub.docker.com/r/olakego/source-postgres/tags
OLAKE_IMAGE=olakego/source-postgres:v1.1.2

# Postgres source
POSTGRES_IMAGE=postgres:16
